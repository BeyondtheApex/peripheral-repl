# Only application sources and distribution inputs belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/LICENSE
!/THIRD_PARTY_NOTICES.txt
!/build.ps1
!/package.ps1
!/src/
!/crates/
!/ui/
!/.github/
**/target/
**/.cargo-ok
**/Cargo.toml.orig
/ui/DISTRIBUTION.md
/ui/vendor/*/Cargo.lock
/ui/vendor/*/*.md
/ui/vendor/*/docs/
/ui/vendor/*/examples/
/ui/vendor/*/benches/
/ui/vendor/*/tests/
*.pdb
*.exe
*.dll
*.log
*.history
